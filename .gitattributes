# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jfif binary
*.ico binary
*.svg text
*.bat text eol=crlf

# Linguist overrides
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.css linguist-language=CSS
